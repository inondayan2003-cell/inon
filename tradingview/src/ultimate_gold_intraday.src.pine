//@version=6
// =====================================================================================================
//  ULTIMATE GOLD INTRADAY  -  XAUUSD  -  Multi-Timeframe SMC / ICT + Trend, weighted score, 1:3 R/R
//  GENERATED FILE - edit tradingview/src/ultimate_gold_intraday.src.pine and run tradingview/build_ultimate_gold.py
//  4H = trend (EMA 50/200) | 1H = structure, sweeps, POI zones | 15M = setup direction | 5M = entry
//  Variants:  A = entry on 15M chart  |  B = entry on 5M chart, 15M structure must agree
//             C = entry on 5M chart, 15M + 1H structure and 4H EMA trend must agree
//  Put it on a 15-minute chart for variant A and on a 5-minute chart for B / C.
//  The 4H swing version (Ultimate_Gold_Indicator / Strategy) is the separate base version.
//  Python reference: research/gold_intraday/engine.py (same rules, bar for bar).
//
//  Non-repainting rules:
//    * All logic runs only on confirmed (closed) bars: `barstate.isconfirmed`.
//    * Higher timeframes: request.security(expr[1], lookahead_on) = only the LAST CLOSED HTF bar is used.
//    * Swing pivots are used only after `swingLen` right-side bars have closed.
//    * Entry price = close of the confirmed signal bar. Exits are checked from the next bar on.
//    * If one bar touches both the stop and the target, the STOP is assumed first (conservative).
//    * Flat every day: an open trade is closed on the bar that ends at 17:00 New York (daily break).
// =====================================================================================================
//#IND indicator("Ultimate Gold Intraday Indicator", shorttitle = "UGI-IND", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)
//#STR strategy("Ultimate Gold Intraday Strategy", shorttitle = "UGI-STR", overlay = true, initial_capital = 10000, currency = currency.USD, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.0125, slippage = 0, process_orders_on_close = true, calc_on_every_tick = false, margin_long = 5, margin_short = 5, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ----------------------------------------------------------------------------------------------- INPUTS
grpSig = "Signal"
variantStr    = input.string("C: 5M entry + 4H/1H/15M trend filter", "Variant", options = ["A: 15M entry", "B: 5M entry + 15M direction", "C: 5M entry + 4H/1H/15M trend filter"], group = grpSig, tooltip = "A on a 15-minute chart, B and C on a 5-minute chart.")
minScore      = input.int(70, "Minimum Signal Score", minval = 0, maxval = 100, group = grpSig)
structWindow  = input.int(12, "Max bars after BOS/CHOCH (entry TF)", minval = 1, group = grpSig)
sweepLookback = input.int(20, "Entry-TF sweep lookback (bars)", minval = 1, group = grpSig)
htfSweepBars  = input.int(8, "1H sweep lookback (1H bars)", minval = 1, group = grpSig)
maxTradesDay  = input.int(5, "Max trades per day", minval = 1, maxval = 20, group = grpSig)
noEntryFrom   = input.int(15, "No new entries from NY hour", minval = 0, maxval = 23, group = grpSig, inline = "ne")
noEntryTo     = input.int(17, "to NY hour (incl.)", minval = 0, maxval = 23, group = grpSig, inline = "ne")
fromTime      = input.time(timestamp("2000-01-01T00:00:00"), "Signals from", group = grpSig)
toTime        = input.time(timestamp("2099-12-31T00:00:00"), "Signals until", group = grpSig)

grpTr = "Trend & Filters"
emaFastLen  = input.int(50, "EMA Fast Length", minval = 1, group = grpTr)
emaSlowLen  = input.int(200, "EMA Slow Length", minval = 1, group = grpTr)
rsiLen      = input.int(14, "RSI Length", minval = 2, group = grpTr)
rsiLongMin  = input.float(40, "RSI long min", group = grpTr, inline = "rl")
rsiLongMax  = input.float(70, "max", group = grpTr, inline = "rl")
rsiShortMin = input.float(30, "RSI short min", group = grpTr, inline = "rs")
rsiShortMax = input.float(60, "max", group = grpTr, inline = "rs")
adxLen      = input.int(14, "ADX Length", minval = 2, group = grpTr)
adxMin      = input.float(20, "ADX Threshold", minval = 0, group = grpTr)
atrLen      = input.int(14, "ATR Length", minval = 1, group = grpTr)
rangeLen    = input.int(48, "Premium/Discount range (bars)", minval = 5, group = grpTr)

grpSmc = "Structure / SMC"
swingLen   = input.int(3, "Swing Sensitivity entry/15M (pivot bars each side)", minval = 2, maxval = 20, group = grpSmc)
htfSwingLen = input.int(3, "Swing Sensitivity 1H/4H", minval = 2, maxval = 20, group = grpSmc)
eqTolAtr   = input.float(0.10, "Equal Highs/Lows tolerance (x ATR)", minval = 0, step = 0.05, group = grpSmc)
maxPools   = input.int(10, "Liquidity levels kept per side", minval = 1, maxval = 50, group = grpSmc)
obLookback = input.int(10, "Order Block lookback (bars)", minval = 1, maxval = 50, group = grpSmc)
obMaxAge   = input.int(100, "Order Block max age (bars)", minval = 1, group = grpSmc)

grpFvg = "FVG Settings"
fvgMinAtr = input.float(0.10, "Min FVG size (x ATR)", minval = 0, step = 0.05, group = grpFvg)
fvgMaxAge = input.int(60, "FVG max age (bars)", minval = 1, group = grpFvg)

grpRisk = "Risk & Stop Management"
slBufferAtr = input.float(0.30, "ATR Multiplier (stop safety buffer)", minval = 0, step = 0.05, group = grpRisk)
minStopAtr  = input.float(0.75, "Min stop distance (x ATR)", minval = 0, step = 0.05, group = grpRisk)
maxStopAtr  = input.float(3.0, "Max stop distance (x ATR) - wider = no trade", minval = 0.1, step = 0.1, group = grpRisk)
rrRatio     = input.float(3.0, "Risk/Reward (target = R x this)", minval = 0.5, step = 0.5, group = grpRisk)
useStopMgmt = input.bool(true, "Stop Management: 1R -> Break Even, 2R -> +1R", group = grpRisk)
costPct     = input.float(0.02, "Round-trip spread (% of price)", minval = 0, step = 0.005, group = grpRisk, tooltip = "Measured on Dukascopy: about 0.015-0.02% of price.")
slipPts     = input.float(0.10, "Round-trip slippage ($)", minval = 0, step = 0.05, group = grpRisk)
maxCostR    = input.float(0.20, "Skip trade if cost > this fraction of the risk", minval = 0.01, step = 0.01, group = grpRisk)

grpW = "Score Weights (sum should be 100)"
wTrend  = input.int(15, "Trend alignment", minval = 0, group = grpW)
wSweep  = input.int(20, "Liquidity Sweep", minval = 0, group = grpW)
wStruct = input.int(15, "BOS / CHOCH", minval = 0, group = grpW)
wFvg    = input.int(15, "FVG", minval = 0, group = grpW)
wOb     = input.int(10, "Order Block", minval = 0, group = grpW)
wRsi    = input.int(5, "RSI", minval = 0, group = grpW)
wAdx    = input.int(10, "ADX", minval = 0, group = grpW)
wZone   = input.int(10, "Entry zone quality", minval = 0, group = grpW)

grpVis = "Display"
showDash   = input.bool(true, "Display Dashboard", group = grpVis)
dashPosStr = input.string("Top Right", "Dashboard position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpVis)
showHist   = input.bool(true, "Display Historical Trades", group = grpVis)
maxHist    = input.int(40, "Max historical trades on chart", minval = 1, maxval = 70, group = grpVis)
showEma    = input.bool(true, "Show EMAs", group = grpVis)
showFvg    = input.bool(true, "Show FVG zones", group = grpVis)
showOb     = input.bool(true, "Show Order Blocks", group = grpVis)
showStruct = input.bool(true, "Show BOS / CHOCH / swings", group = grpVis)
showLiq    = input.bool(true, "Show Equal Highs/Lows and sweeps", group = grpVis)

colProfit = color.new(color.green, 80)
colLoss   = color.new(color.red, 80)

// ----------------------------------------------------------------------------------------------- TYPES
type Zone
    float top
    float bottom
    int   barIdx
    bool  bull
    box   bx

type Pool
    float price
    int   barIdx
    bool  equal
    line  ln

// ----------------------------------------------------------------------------------------------- INDICATORS (computed on every bar)
emaF = ta.ema(close, emaFastLen)
emaS = ta.ema(close, emaSlowLen)
rsiV = ta.rsi(close, rsiLen)
[diPlus, diMinus, adxV] = ta.dmi(adxLen, adxLen)
atrV = ta.atr(atrLen)
hhR  = ta.highest(high, rangeLen)
llR  = ta.lowest(low, rangeLen)

// Pivot test: centre bar = swingLen bars ago. Left side strictly lower, right side lower or equal.
leftMaxH  = ta.highest(high, swingLen)[swingLen + 1]
rightMaxH = ta.highest(high, swingLen)
leftMinL  = ta.lowest(low, swingLen)[swingLen + 1]
rightMinL = ta.lowest(low, swingLen)
isPivH = bar_index >= 2 * swingLen and high[swingLen] > leftMaxH and high[swingLen] >= rightMaxH
isPivL = bar_index >= 2 * swingLen and low[swingLen] < leftMinL and low[swingLen] <= rightMinL
pivHVal = high[swingLen]
pivLVal = low[swingLen]

warmBars = math.max(emaSlowLen, 50)
NOBAR = -1000000000
variant = str.substring(variantStr, 0, 1)

// ----------------------------------------------------------------------------------------------- HIGHER TIMEFRAMES
// Add a price level to a liquidity pool list, merging levels within tolerance (equal highs / lows).
poolAdd(array<float> pools, float price, float tol, bool isHigh) =>
    bool merged = false
    if pools.size() > 0
        for j = 0 to pools.size() - 1
            if not merged and math.abs(pools.get(j) - price) <= tol
                pools.set(j, isHigh ? math.max(pools.get(j), price) : math.min(pools.get(j), price))
                merged := true
    if not merged
        pools.push(price)
        if pools.size() > maxPools
            pools.shift()

// SMC state of one timeframe, evaluated inside request.security. Same rules as the chart-timeframe engine.
// Returns the values of the PREVIOUS bar of that timeframe ([1]); with lookahead_on this is the last CLOSED bar.
// [structure trend, EMA bias, bars since bullish sweep, bars since bearish sweep, last bull zone top/bottom, last bear zone top/bottom]
htfState(int sLen) =>
    float a = ta.atr(atrLen)
    float eF = ta.ema(close, emaFastLen)
    float eS = ta.ema(close, emaSlowLen)
    float lMaxH = ta.highest(high, sLen)[sLen + 1]
    float rMaxH = ta.highest(high, sLen)
    float lMinL = ta.lowest(low, sLen)[sLen + 1]
    float rMinL = ta.lowest(low, sLen)
    var float hsh = na
    var float hsl = na
    var bool hshB = true
    var bool hslB = true
    var int hms = 0
    var int bSw = NOBAR
    var int sSw = NOBAR
    var float bSwPx = na
    var float sSwPx = na
    var array<float> hp = array.new<float>()
    var array<float> lp = array.new<float>()
    var array<float> zT = array.new<float>()
    var array<float> zB = array.new<float>()
    var array<int>   zBar = array.new<int>()
    var array<bool>  zBull = array.new<bool>()
    var array<bool>  zFvg = array.new<bool>()
    float tol = eqTolAtr * (na(a) ? 0.0 : a)
    if bar_index >= 2 * sLen and high[sLen] > lMaxH and high[sLen] >= rMaxH
        hsh := high[sLen]
        hshB := false
        poolAdd(hp, high[sLen], tol, true)
    if bar_index >= 2 * sLen and low[sLen] < lMinL and low[sLen] <= rMinL
        hsl := low[sLen]
        hslB := false
        poolAdd(lp, low[sLen], tol, false)
    if not hshB and not na(hsh) and close > hsh
        hshB := true
        hms := 1
        for k = 1 to obLookback
            if close[k] < open[k]
                zT.push(high[k])
                zB.push(low[k])
                zBar.push(bar_index)
                zBull.push(true)
                zFvg.push(false)
                break
    if not hslB and not na(hsl) and close < hsl
        hslB := true
        hms := -1
        for k = 1 to obLookback
            if close[k] > open[k]
                zT.push(high[k])
                zB.push(low[k])
                zBar.push(bar_index)
                zBull.push(false)
                zFvg.push(false)
                break
    if lp.size() > 0
        for j = lp.size() - 1 to 0
            float pp = lp.get(j)
            if low < pp
                if close > pp
                    if bSw != bar_index
                        bSwPx := low
                    bSw := bar_index
                lp.remove(j)
    if hp.size() > 0
        for j = hp.size() - 1 to 0
            float pp = hp.get(j)
            if high > pp
                if close < pp
                    if sSw != bar_index
                        sSwPx := high
                    sSw := bar_index
                hp.remove(j)
    if bSw != NOBAR and close < bSwPx
        bSw := NOBAR
    if sSw != NOBAR and close > sSwPx
        sSw := NOBAR
    if zT.size() > 0
        for j = zT.size() - 1 to 0
            bool bl = zBull.get(j)
            int zb = zBar.get(j)
            float tp_ = zT.get(j)
            float bt_ = zB.get(j)
            bool dead = false
            if zFvg.get(j)
                dead := zb < bar_index and (bl ? (low <= bt_ or close < bt_) : (high >= tp_ or close > tp_))
                dead := dead or bar_index - zb > fvgMaxAge
            else
                dead := zb < bar_index and ((bl and close < bt_) or (not bl and close > tp_) or bar_index - zb > obMaxAge)
            if dead
                zT.remove(j)
                zB.remove(j)
                zBar.remove(j)
                zBull.remove(j)
                zFvg.remove(j)
    if bar_index >= 2 and not na(a)
        if low > high[2] and low - high[2] >= fvgMinAtr * a
            zT.push(low)
            zB.push(high[2])
            zBar.push(bar_index)
            zBull.push(true)
            zFvg.push(true)
        if high < low[2] and low[2] - high >= fvgMinAtr * a
            zT.push(low[2])
            zB.push(high)
            zBar.push(bar_index)
            zBull.push(false)
            zFvg.push(true)
    float bzT = na
    float bzB = na
    float szT = na
    float szB = na
    if zT.size() > 0
        for j = 0 to zT.size() - 1
            if zBull.get(j)
                bzT := zT.get(j)
                bzB := zB.get(j)
            else
                szT := zT.get(j)
                szB := zB.get(j)
    int emaBias = eF > eS ? 1 : eF < eS ? -1 : 0
    int bAge = bar_index - bSw
    int sAge = bar_index - sSw
    [hms[1], emaBias[1], bAge[1], sAge[1], bzT[1], bzB[1], szT[1], szB[1]]

[ms4, ema4, bAge4, sAge4, bz4T, bz4B, sz4T, sz4B] = request.security(syminfo.tickerid, "240", htfState(htfSwingLen), lookahead = barmerge.lookahead_on)
[ms1, ema1, bAge1, sAge1, bz1T, bz1B, sz1T, sz1B] = request.security(syminfo.tickerid, "60", htfState(htfSwingLen), lookahead = barmerge.lookahead_on)
[ms15, ema15, bAge15, sAge15, bz15T, bz15B, sz15T, sz15B] = request.security(syminfo.tickerid, "15", htfState(swingLen), lookahead = barmerge.lookahead_on)
htfReady = not na(ms4) and not na(ms1) and not na(ms15)

// trading day bookkeeping (New York): the bar that ends at 17:00 is the last bar of the trading day
isLastOfDay = hour(time_close, "America/New_York") == 17 and minute(time_close, "America/New_York") == 0
nyHour = hour(time, "America/New_York")
entryHourOk = not (nyHour >= noEntryFrom and nyHour <= noEntryTo)

