# Firebase (Project settings → General → Your apps → Web app). These are public values, not secrets.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Sign-in methods offered (google, email are free; phone and apple cost money)
NAILS_SIGNIN_METHODS=google,email

# Contact page (leave empty until you have them)
NAILS_SUPPORT_EMAIL=
NAILS_SUPPORT_PHONE=0528326523

# Who runs the service: shown on the contact page and in the terms (leave empty to hide)
NAILS_OPERATOR_NAME=
NAILS_OPERATOR_ID=
NAILS_OPERATOR_ADDRESS=

# Admin screen (approving business-owner verification): the Google/email accounts of the admins
NAILS_ADMIN_EMAILS=

# Where data (database + photos) is stored
NAILS_DATA=data

# Local development only: fake accounts instead of Firebase. Never on a real server!
# NAILS_DEV_AUTH=1
