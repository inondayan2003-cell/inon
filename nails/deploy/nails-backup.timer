# Every night at 00:00 Israel time. Persistent: if the server was off at midnight,
# the backup runs as soon as it starts again.
[Unit]
Description=Nails backup every night at 00:00 (Israel)

[Timer]
OnCalendar=*-*-* 00:00:00 Asia/Jerusalem
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
